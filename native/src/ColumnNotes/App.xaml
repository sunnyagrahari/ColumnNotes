<Application x:Class="ColumnNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
  <Application.Resources>
    <SolidColorBrush x:Key="PaperBrush" Color="#F4EFE6"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#E8E2D6"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1A1714"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B635A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3D6B5A"/>
    <SolidColorBrush x:Key="AccentFgBrush" Color="#F4EFE6"/>
    <SolidColorBrush x:Key="TitleBrush" Color="#2C4A3E"/>
    <SolidColorBrush x:Key="LineBrush" Color="#241A1714"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#261A1714"/>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="{StaticResource ChromeBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="1,2"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource LineBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ChromeBtn}"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{StaticResource ChromeBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="StatusBarItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
  </Application.Resources>
</Application>
